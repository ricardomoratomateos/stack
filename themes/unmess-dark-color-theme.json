  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#444444", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "string.interpolated"],
      "settings": { "foreground": "#7a9e8a" }
    },
    {
      "name": "String punctuation",
      "scope": ["punctuation.definition.string", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#7a9e8a" }
    },
    {
      "name": "Template expression braces",
      "scope": ["punctuation.section.embedded", "meta.template.expression"],
      "settings": { "foreground": "#c9d1d9" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.other.color"],
      "settings": { "foreground": "#c8a870" }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": ["constant.language"],
      "settings": { "foreground": "#c8a870" }
    },
    {
      "name": "Constants",
      "scope": ["constant.other", "variable.other.constant"],
      "settings": { "foreground": "#c9d1d9" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.void",
        "keyword.operator.in",
        "keyword.operator.instanceof",
        "keyword.operator.of"
      ],
      "settings": { "foreground": "#8899cc" }
    },
    {
      "name": "Storage keywords (let, const, var, function, class)",
      "scope": ["storage.type", "storage.modifier"],
      "settings": { "foreground": "#8899cc" }
    },
    {
      "name": "Import / export",
      "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.export", "keyword.control.as"],
      "settings": { "foreground": "#8899cc" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#686868" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": { "foreground": "#525252" }
    },
    {
      "name": "Function declarations",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#c8c0b4" }
    },
    {
      "name": "Function calls",
      "scope": ["meta.function-call entity.name.function"],
      "settings": { "foreground": "#c8c0b4" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": { "foreground": "#8899b8" }
    },
    {
      "name": "Type annotations",
      "scope": ["meta.type.annotation", "meta.return.type", "meta.type.parameters"],
      "settings": { "foreground": "#8899b8" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": { "foreground": "#c9d1d9" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#b8c8d8" }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.object.property",
        "support.variable.property",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#8a9aaa" }
    },
    {
      "name": "Enum members",
      "scope": ["variable.other.enummember"],
      "settings": { "foreground": "#c8a870" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#8aad7a", "fontStyle": "italic" }
    },
    {
      "name": "HTML/JSX tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#8aad7a" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#7a9e8a" }
    },
    {
      "name": "HTML/JSX tag angle brackets",
      "scope": ["punctuation.definition.tag", "meta.tag.inline punctuation"],
      "settings": { "foreground": "#525252" }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "source.css support.type.property-name"
      ],
      "settings": { "foreground": "#8a9aaa" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#8aad7a" }
    },
    {
      "name": "CSS values / units",
      "scope": ["support.constant.property-value.css", "constant.numeric.css", "keyword.other.unit.css"],
      "settings": { "foreground": "#c8a870" }
    },
    {
      "name": "CSS colors",
      "scope": ["constant.other.color.rgb-value.css", "constant.other.color.rgba-value.css"],
      "settings": { "foreground": "#c8a870" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": { "foreground": "#c8a870" }
    },
    {
      "name": "Regex quantifiers",
      "scope": ["keyword.operator.quantifier.regexp", "constant.character.escape.regexp"],
      "settings": { "foreground": "#b88820" }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.quoted.double.json meta.structure.dictionary.key.json"
      ],
      "settings": { "foreground": "#8a9aaa" }
    },
    {
      "name": "YAML keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#8aad7a" }
    },
    {
      "name": "YAML anchors",
      "scope": ["entity.name.type.anchor.yaml", "variable.other.alias.yaml"],
      "settings": { "foreground": "#7a9e8a" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#8aad7a", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#fafafa", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": { "foreground": "#4493f8" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#7a9e8a" }
    },
    {
      "name": "Markdown list bullets",
      "scope": ["beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "#8aad7a" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#838383", "fontStyle": "italic" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#3fb950" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#f04438" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#d29922" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "#f04438", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#d29922", "fontStyle": "strikethrough" }
    },
    {
      "name": "PHP / other language tags",
      "scope": ["punctuation.section.embedded.begin", "punctuation.section.embedded.end"],
      "settings": { "foreground": "#8899cc" }
    },
    {
      "name": "Shell built-ins",
      "scope": ["support.function.builtin.shell"],
      "settings": { "foreground": "#8aad7a" }
    },
    {
      "name": "Shell variables",
      "scope": ["variable.other.normal.shell", "variable.other.bracket.shell"],
      "settings": { "foreground": "#c9d1d9" }
    }
  ]
}
