    "modifier":                 "#8899cc",
    "string":                   "#7a9e8a",
    "number":                   "#c8a870",
    "regexp":                   "#c8a870",
    "operator":                 "#686868",
    "decorator":                { "foreground": "#8aad7a", "italic": true },
    "property":                 "#8a9aaa",
    "property.readonly":        "#8a9aaa",
    "macro":                    "#8899cc",
    "comment":                  { "foreground": "#444444", "italic": true },
    "label":                    "#a3a3a3",
    "builtinType":              "#8899b8",
    "attribute":                "#7a9e8a",
    "selfParameter":            "#c9d1d9"
