{
  "name": "stack-agents",
  "description": "Stack's Node side: the stackd daemon and the MCP bridge the desktop app (desktop/) bundles. Runs parallel AI coding agents (Claude Code, opencode) across git worktrees, each in its own tmux session.",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/ricardomoratomateos/stack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardomoratomateos/stack.git"
  },
  "bugs": {
    "url": "https://github.com/ricardomoratomateos/stack/issues"
  },
  "keywords": [
    "git worktree",
    "worktree",
    "ai agent",
    "agents",
    "multi-agent",
    "claude code",
    "opencode",
    "cursor",
    "tmux",
    "parallel"
  ],
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preversion": "npm run typecheck && npm run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vscode/codicons": "^0.0.45",
    "diff2html": "^3.4.56",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.7"
  }
}
