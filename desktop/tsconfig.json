{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "src",
    "../src/webview",
    "../src/sidebarStyle.ts",
    "../src/application/deletePlan.ts",
    "../src/newtask/composer.ts"
  ]
}