# Everything the extension needs at runtime is in dist/: esbuild bundles the
# TypeScript and copies codicon.css + codicon.ttf next to it. So the whole
# toolchain, the sources and node_modules stay out of the .vsix.
.DS_Store
**/.DS_Store

# Sources and tests — the bundle is what ships.
src/**
test/**
coverage/**
**/*.map

# Build + tooling config.
esbuild.js
vitest.config.ts
tsconfig.json
tsconfig.webview.json
.eslintrc*
.editorconfig

# Dev-only directories.
.vscode/**
.github/**
node_modules/**
# Personal permission allowlist and any other local agent config — this is the
# developer's machine setup, not part of the extension.
.claude/**
.agents/**
skills-lock.json

# Repo hygiene that has no place in an installable package.
.gitignore
.vscodeignore
